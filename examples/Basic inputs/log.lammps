#################### 3) Initializing the NVT ensemble ####################
# scaling the size of the system to the average volume
variable sidesize equal (f_VoluAve^(1.0/3.0))    # get the volume
variable xlow equal xlo
variable ylow equal ylo
variable zlow equal zlo
variable xhig equal (xlo+${sidesize})
variable xhig equal (xlo+28.7525083296275)
variable yhig equal (ylo+${sidesize})
variable yhig equal (ylo+28.7525083296275)
variable zhig equal (zlo+${sidesize})
variable zhig equal (zlo+28.7525083296275)
change_box all x final ${xlow} ${xhig} y final ${ylow} ${yhig} z final ${zlow} ${zhig}
change_box all x final 0.669121552309745 ${xhig} y final ${ylow} ${yhig} z final ${zlow} ${zhig}
change_box all x final 0.669121552309745 29.4216298819372 y final ${ylow} ${yhig} z final ${zlow} ${zhig}
change_box all x final 0.669121552309745 29.4216298819372 y final 0.674620552309745 ${yhig} z final ${zlow} ${zhig}
change_box all x final 0.669121552309745 29.4216298819372 y final 0.674620552309745 29.4271288819372 z final ${zlow} ${zhig}
change_box all x final 0.669121552309745 29.4216298819372 y final 0.674620552309745 29.4271288819372 z final 0.670620552309744 ${zhig}
change_box all x final 0.669121552309745 29.4216298819372 y final 0.674620552309745 29.4271288819372 z final 0.670620552309744 29.4231288819372
Changing box ...
  orthogonal box = (0.66912155 0.67462055 0.67062055) to (29.42163 29.337379 29.333379)
  orthogonal box = (0.66912155 0.67462055 0.67062055) to (29.42163 29.427129 29.333379)
  orthogonal box = (0.66912155 0.67462055 0.67062055) to (29.42163 29.427129 29.423129)
unfix DensAve
unfix VoluAve
reset_timestep 0

# changing the ensemble to NVT
unfix integrate
fix integrate all nvt temp ${Temp} ${Temp} 100.0
fix integrate all nvt temp 298 ${Temp} 100.0
fix integrate all nvt temp 298 298 100.0

# Initializing the whole system with very small timesteps in the NVT ensemble
timestep 0.001
run ${Ninvtpre}
run 10000
