#################### 3) Initializing the NVT ensemble ####################
# scaling the size of the system to the average volume
variable sidesize equal (f_VolumeAve^(1.0/3.0))    # get the volume
variable xlow equal xlo
variable ylow equal ylo
variable zlow equal zlo
variable xhig equal (xlo+${sidesize})
variable xhig equal (xlo+45.6281133524567)
variable yhig equal (ylo+${sidesize})
variable yhig equal (ylo+45.6281133524567)
variable zhig equal (zlo+${sidesize})
variable zhig equal (zlo+45.6281133524567)
change_box all x final ${xlow} ${xhig} y final ${ylow} ${yhig} z final ${zlow} ${zhig}
change_box all x final -1.01024217998674 ${xhig} y final ${ylow} ${yhig} z final ${zlow} ${zhig}
change_box all x final -1.01024217998674 44.61787117247 y final ${ylow} ${yhig} z final ${zlow} ${zhig}
change_box all x final -1.01024217998674 44.61787117247 y final -1.01024217998674 ${yhig} z final ${zlow} ${zhig}
change_box all x final -1.01024217998674 44.61787117247 y final -1.01024217998674 44.61787117247 z final ${zlow} ${zhig}
change_box all x final -1.01024217998674 44.61787117247 y final -1.01024217998674 44.61787117247 z final -1.01024217998674 ${zhig}
change_box all x final -1.01024217998674 44.61787117247 y final -1.01024217998674 44.61787117247 z final -1.01024217998674 44.61787117247
Changing box ...
  orthogonal box = (-1.0102422 -1.0102422 -1.0102422) to (44.617871 44.63601 44.63601)
  orthogonal box = (-1.0102422 -1.0102422 -1.0102422) to (44.617871 44.617871 44.63601)
  orthogonal box = (-1.0102422 -1.0102422 -1.0102422) to (44.617871 44.617871 44.617871)
unfix DensAve
unfix VolumeAve
unfix AveAll

# changing the ensemble to NVT
unfix integrate
fix integrate all nvt temp ${Temp} ${Temp} 100.0
fix integrate all nvt temp 298 ${Temp} 100.0
fix integrate all nvt temp 298 298 100.0

# Initializing the whole system with very small timesteps in the NVT ensemble
timestep 0.001
run ${Ninvtpre}
run 10000
