#################### 3) Initializing the NVT ensemble ####################
# scaling the size of the system to the average volume
variable sidesize equal (f_VolumeAve^(1.0/3.0))    # get the volume
variable xlow equal xlo
variable ylow equal ylo
variable zlow equal zlo
variable xhig equal (xlo+${sidesize})
variable xhig equal (xlo+45.629356133665)
variable yhig equal (ylo+${sidesize})
variable yhig equal (ylo+45.629356133665)
variable zhig equal (zlo+${sidesize})
variable zhig equal (zlo+45.629356133665)
change_box all x final ${xlow} ${xhig} y final ${ylow} ${yhig} z final ${zlow} ${zhig}
change_box all x final -0.985901153250072 ${xhig} y final ${ylow} ${yhig} z final ${zlow} ${zhig}
change_box all x final -0.985901153250072 44.6434549804149 y final ${ylow} ${yhig} z final ${zlow} ${zhig}
change_box all x final -0.985901153250072 44.6434549804149 y final -0.985901153250072 ${yhig} z final ${zlow} ${zhig}
change_box all x final -0.985901153250072 44.6434549804149 y final -0.985901153250072 44.6434549804149 z final ${zlow} ${zhig}
change_box all x final -0.985901153250072 44.6434549804149 y final -0.985901153250072 44.6434549804149 z final -0.985901153250072 ${zhig}
change_box all x final -0.985901153250072 44.6434549804149 y final -0.985901153250072 44.6434549804149 z final -0.985901153250072 44.6434549804149
Changing box ...
  orthogonal box = (-0.98590115 -0.98590115 -0.98590115) to (44.643455 44.611669 44.611669)
  orthogonal box = (-0.98590115 -0.98590115 -0.98590115) to (44.643455 44.643455 44.611669)
  orthogonal box = (-0.98590115 -0.98590115 -0.98590115) to (44.643455 44.643455 44.643455)
unfix DensAve
unfix VolumeAve
unfix AveAll

# changing the ensemble to NVT
unfix integrate
fix integrate all nvt temp ${Temp} ${Temp} 100.0
fix integrate all nvt temp 298 ${Temp} 100.0
fix integrate all nvt temp 298 298 100.0

# Initializing the whole system with very small timesteps in the NVT ensemble
timestep 0.001
run ${Ninvtpre}
run 10000
