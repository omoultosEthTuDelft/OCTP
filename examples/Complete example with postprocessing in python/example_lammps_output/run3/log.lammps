reset_timestep 0
#################### 2) NPT Production (Obtaining average volume) ######################
variable TotEn equal etotal
variable PotEn equal pe
variable Volume equal vol
variable Dens equal density
compute T all temp
compute P all pressure T


# Getting the average volume and density of the system
fix VolumeAve all ave/time 1 ${Npnpt} ${Npnpt} v_Volume file volume.dat
fix VolumeAve all ave/time 1 1000000 ${Npnpt} v_Volume file volume.dat
fix VolumeAve all ave/time 1 1000000 1000000 v_Volume file volume.dat
fix DensAve all ave/time 1 ${Npnpt} ${Npnpt} v_Dens file density.dat
fix DensAve all ave/time 1 1000000 ${Npnpt} v_Dens file density.dat
fix DensAve all ave/time 1 1000000 1000000 v_Dens file density.dat
fix AveAll all ave/time ${Ne} ${Nr} ${Nf} v_TotEn v_PotEn c_T c_P v_Dens file npt_prod.dat
fix AveAll all ave/time 10 ${Nr} ${Nf} v_TotEn v_PotEn c_T c_P v_Dens file npt_prod.dat
fix AveAll all ave/time 10 10 ${Nf} v_TotEn v_PotEn c_T c_P v_Dens file npt_prod.dat
fix AveAll all ave/time 10 10 100 v_TotEn v_PotEn c_T c_P v_Dens file npt_prod.dat

run ${Npnpt}
run 1000000
